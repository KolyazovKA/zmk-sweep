// Версия 3.0 

// BASE LAYER
// Desc: Alfabet (main) layer
//   ╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//   │  Q       │  W       │  E       │  R       │  T       │   │  Y       │  U       │  I       │  O       │  P       │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │  A       │  S(LALT) │  D(LCTRL)│  F($WIN) │  G       │   │  H       │  J(RGUI) │  K(RCTRL)│  L(RALT) │ ;(RSHIFT)│
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │  Z       │  X       │  C       │  V       │  B       │   │  N       │  M       │ ,        │ .        │ /        │
//   ╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                    │ LCTRL    │    BSPC  │   │  SPACE   │  LSHIFT  │
//                                    │          │  &NUMBER │   │ SYMBOL   │ CAPSLOCK │
//                                    ╰──────────┴──────────╯   ╰──────────┴──────────╯
//
// =================================================================================================================================
//
// SYMBOL LAYER
// Desc:  All special characters layer
//   ╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//   │          │          │  {       │  }       │  |       │   │  `       │  ~       │  <       │  >       │  \       │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │LS(ENTER) │          │  (       │  )       │  :       │   │  +       │  -       │  /       │  *       │  '       │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │          │          │  [       │  ]       │  ?       │   │  &       │  _       │  =       │  .       │  "       │
//   ╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                    │          │          │   │   (*)    │          │
//                                    ╰──────────┴──────────╯   ╰──────────┴──────────╯
//
// =================================================================================================================================
//
// NUMBER LAYER
// Desc: All numbeers and navigation
//
//   ╭──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//   │ TAB      │  1       │  2       │  3       │    +     │  │ HOME     │ PG_DN    │ PG_UP    │ END      │SHIFT+INS │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │ DELETE   │  4       │  5       │  6       │    -     │  │ LEFT     │ DOWN     │  UP      │  RIGHT   │ CTRL+INS │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │          │  7       │  8       │  9       │    0     │  │          │     .    │     ,    │          │   BSPC   │
//   ╰──────────┴──────────┴──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                    │          │   (*)    │  │  LCTRL   │  LSHIFT  │
//                                    ╰──────────┴──────────╯  ╰──────────┴──────────╯
//
// =================================================================================================================================
//
// FUNCTION LAYER
// Desc: A layer with function keys and keyboard control keys.
//
//   ╭──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//   │          │  F1      │  F2      │  F3      │   (*)    │  │   (*)    │ F4       │ F5       │ F6       │          │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │          │  F7      │  F8      │  F9      │          │  │          │ F10      │  F11     │  F12     │          │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │ RESET    │BOOTLOADER│          │          │          │  │          │ PROFILE0 │ PROFILE1 │ PROFILE2 │ CLEAR BT │
//   ╰──────────┴──────────┴──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                    │          │          │  │ RESET    │BOOTLOADER│
//                                    ╰──────────┴──────────╯  ╰──────────┴──────────╯
//
// =================================================================================================================================
//
// WINDOWS LAYER
// Desc: A layer with win macros
//   ╭──────────┬──────────┬──────────┬──────────┬──────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//   │  Win+L   │          │ Explorer │ Win+R    │          │  │          │          │ Settings │          │ SCR LOCK │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │          │ '"+p'    │  '"+y'   │   (*)    │          │  │W+Ctrl+<- │W+Shift+<-│W+Shift+->│ W+Ctrl+->│ Emogie   │
//   ├──────────┼──────────┼──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┤
//   │ PRT SCR  │          │          │          │          │  │ Win+LEFT │ Win+Down │ Win+Up   │ Win+RIGHT│          │
//   ╰──────────┴──────────┴──────────┼──────────┼──────────┤  ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                    │          │          │  │  SPACE   │          │
//                                    ╰──────────┴──────────╯  ╰──────────┴──────────╯

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Слои
#define BASE      0 // Основной слой с английскими буквами
#define SYMBOL    1 // Слой со спецсимволами
#define NUMBER    2 // Слой с цифрами и навигацией
#define FUNCTION  3 // Слой с функциональными клавишами
#define WINDOWS   4 // Слой с различными сочетаниями с кнопкой Windows
#define RU        5 // Основной слой с русскими буквами
#define SYMBOLRU  6 // Слой со спецсимволами для ru mod

// Key position definitions for Ferris Sweep (34 keys)
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

&sk {
  release-after-ms = <1000>;
  quick-release;
};

&sl {
  ignore-modifiers;
};

&caps_word {
  /delete-property/ ignore-modifiers;
};

/ {
  behaviors {
    // Зажатие - &kp, нажатие - &sl
    sl_ctrl: sticky_layer_ctrl {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&kp>, <&sl>;
    };

    // Hot-tap
    ht: hold_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <220>;
      quick-tap-ms = <150>;
      require-prior-idle-ms = <100>;
      bindings = <&kp>, <&kp>;
    };

    // Left hand home row mods
    hml: hml {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
    };

    // Right hand home row mods
    hmr: hmr {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
    };

    // Left hand home row mods for number layer (no idle requirement)
    hml_s: hml_s {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <0>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
    };

    // Right hand home row mods for number layer (no idle requirement)
    hmr_s: hmr_s {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <0>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
    };

    // Smart shift: tap for sticky shift, double tap for caps word
    smart_shift: smart_shift {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <250>;
      bindings = <&sk LSHIFT>, <&caps_word>;
    };

    // Windows layer kye
    lt_win: lt_win {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      quick-tap-ms = <175>;
      bindings = <&mo>, <&kp>;
    };
  };

  macros {
    // Copy in nvim
    vim_copy: vim_copy {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
      = <&kp DQT>
      , <&kp PLUS>
      , <&kp Y>
      ;
    };

    // Past in nvim
    vim_paste: vim_paste {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
      = <&kp DQT>
      , <&kp PLUS>
      , <&kp P>
      ;
    };

    // Переключение на русскую раскладку
    to_ru: to_ru {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&kp LC(LS(N2))>
      , <&to RU>
      ;
    };

    // Переключение на английскую раскладку
    to_en: to_en {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&kp LC(LS(N1))>
      , <&to BASE>
      ;
    };

    symbol_en_lcurly: symbol_en_lcurly {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp LBRC>
      , <&to_ru>
      ;
    };

    symbol_en_rcurly: symbol_en_rcurly {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp RBRC>
      , <&to_ru>
      ;
    };

    symbol_en_pipe: symbol_en_pipe {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp PIPE>
      , <&to_ru>
      ;
    };

    symbol_en_grave: symbol_en_grave {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp GRAVE>
      , <&to_ru>
      ;
    };

    symbol_en_tilde: symbol_en_tilde {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp LS(GRAVE)>
      , <&to_ru>
      ;
    };

    symbol_en_lt: symbol_en_lt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp LT>
      , <&to_ru>
      ;
    };

    symbol_en_gt: symbol_en_gt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp GT>
      , <&to_ru>
      ;
    };

    symbol_en_bslash: symbol_en_bslash {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp BSLH>
      , <&to_ru>
      ;
    };

    symbol_en_lbkt: symbol_en_lbkt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp LBKT>
      , <&to_ru>
      ;
    };

    symbol_en_rbkt: symbol_en_rbkt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp RBKT>
      , <&to_ru>
      ;
    };

    symbol_en_amps: symbol_en_amps {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp AMPS>
      , <&to_ru>
      ;
    };

    symbol_en_sqt: symbol_en_sqt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
      = <&to_en>
      , <&kp SQT>
      , <&to_ru>
      ;
    };
  };

  combos {
    compatible = "zmk,combos";
    timeout-ms = <50>;
    require-prior-idle-ms = <150>;

    // ESC on W+E
    combo_esc {
      key-positions = <1 2>;
      layers = <BASE RU>;
      bindings = <&kp ESCAPE>;
    };

    // TAB on E+R
    combo_tab {
      key-positions = <2 3>;
      layers = <BASE RU>;
      bindings = <&kp TAB>;
    };

    // CTRL+Backspace on S+D
    combo_ctrl_bspc {
      key-positions = <11 12>;
      layers = <BASE RU>;
      bindings = <&kp LC(BSPC)>;
    };

    // Enter on F+D
    combo_enter {
      key-positions = <12 13>;
      layers = <BASE RU>;
      bindings = <&kp RET>;
    };

    // "{" on U+I
    combo_left_curly_bracket {
      key-positions = <6 7>;
      layers = <BASE RU>;
      bindings = <&kp LBRC>;
    };

    // "}" on I+O
    combo_right_curly_bracket {
      key-positions = <7 8>;
      layers = <BASE RU>;
      bindings = <&kp RBRC>;
    };

    // "(" on J+K
    combo_left_bracket {
      key-positions = <16 17>;
      layers = <BASE RU>;
      bindings = <&kp LPAR>;
    };

    // ")" on K+L
    combo_right_bracket {
      key-positions = <17 18>;
      layers = <BASE RU>;
      bindings = <&kp RPAR>;
    };

    // "[" on M+,
    combo_left_square_bracket {
      key-positions = <26 27>;
      layers = <BASE RU>;
      bindings = <&kp LBKT>;
    };

    // "]" on ,+.
    combo_right_square_bracket {
      key-positions = <27 28>;
      layers = <BASE RU>;
      bindings = <&kp RBKT>;
    };

    // Переключить раскладку на RU: X+C 
    combo_to_ru {
      key-positions = <21 22>;
      layers = <BASE RU>;
      require-prior-idle-ms = <0>;
      bindings = <&to_ru>;
    };

    // Переключить раскладку на EN: C+V
    combo_to_en {
      key-positions = <22 23>;
      layers = <BASE RU>;
      require-prior-idle-ms = <0>;
      bindings = <&to_en>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base_layer {
      display-name = "Base";
      bindings = <
        &kp Q   &kp W         &kp E          &kp R              &lt FUNCTION T   &lt FUNCTION Y        &kp U          &kp I           &kp O         &kp P
        &kp A   &hml LALT S   &hml LCTRL D   &lt_win WINDOWS F        &kp G            &kp H        &hmr RGUI J    &hmr RCTRL  K   &hmr RALT L      &kp SEMI
        &kp Z   &kp X         &kp C          &kp V              &kp B            &kp N        &kp M          &kp COMMA       &kp DOT       &kp FSLH
        &kp LCTRL    &lt NUMBER BSPC    &lt SYMBOL SPACE     &smart_shift
      >;
    };

    symbol_layer {
      display-name = "Symbol";
      bindings = <

        &kp RET      &none     &kp LBRC   &kp RBRC   &kp PIPE       &kp GRAVE  &kp TILDE  &kp LT     &kp GT     &kp BSLH
        &kp LS(RET)  &none     &kp LPAR   &kp RPAR   &kp COLON      &kp PLUS   &kp MINUS  &kp FSLH   &kp ASTRK  &kp SQT
        &none        &none     &kp LBKT   &kp RBKT   &kp QMARK      &kp AMPS   &kp UNDER  &kp EQUAL  &kp DOT    &kp DQT
        &trans       &trans    &none    &trans
      >;
    };

    number_layer {
      display-name = "Number";
      bindings = <
        &kp TAB     &kp N1            &kp N2            &kp N3           &kp PLUS            &kp HOME         &kp PG_DN         &kp PG_UP         &kp END             &kp LS(INS)
        &kp DEL     &hml_s LALT N4    &hml_s LSHIFT N5  &hml_s LCTRL N6  &kp MINUS           &kp LEFT         &kp DOWN          &kp UP            &kp RIGHT           &kp LC(INS)
        &none       &kp N7            &kp N8            &kp N9           &kp N0              &none            &kp DOT           &kp COMMA         &kp BSPC            &none
        &trans      &trans            &kp LCTRL         &kp LSHIFT
      >;
    };

    function_layer {
      display-name = "Function";
      bindings = <
        &trans      &kp F1       &kp F2     &kp F3     &none            &none       &kp F4        &kp F5        &kp F6        &trans
        &trans      &kp F7       &kp F8     &kp F9     &none            &none       &kp F10       &kp F11       &kp F12       &trans
        &sys_reset  &bootloader  &trans     &trans     &trans           &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR
        &trans      &trans       &sys_reset       &bootloader
      >;
    };

    windows_layer {
      display-name = "Winodws";
      bindings = <
        &kp LG(L)      &none       &kp LG(E)  &kp LG(R)  &none     &none              &none              &kp LG(I)           &none               &kp LG(L)
        &none          &vim_paste  &vim_copy  &none      &none     &kp LG(LC(LEFT))   &kp LG(LS(LEFT))   &kp LG(LS(RIGHT))   &kp LG(LC(RIGHT))   &kp LG(DOT)
        &kp LG(LS(S))  &none       &none      &none      &none     &kp LG(LEFT)       &kp LG(DOWN)         &kp LG(UP)        &kp LG(RIGHT)       &none
        &none      &none       &kp LG(SPACE)     &none
      >;
    };

    ru_layer {
      display-name = "RU";
      bindings = <
        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &lt SYMBOLRU SPACE   &trans
      >;
    };

    symbol_ru_layer {
      display-name = "Symbol RU";
      bindings = <
        &kp RET         &none  &symbol_en_lcurly  &symbol_en_rcurly  &symbol_en_pipe  &symbol_en_grave  &symbol_en_tilde  &symbol_en_lt  &symbol_en_gt     &symbol_en_bslash
        &kp LS(RET)     &none  &kp LPAR           &kp RPAR           &kp LS(N6)       &kp PLUS          &kp MINUS         &kp PIPE       &kp LS(N8)        &kp SQT
        &none           &none  &symbol_en_lbkt    &symbol_en_rbkt    &kp LS(N7)       &symbol_en_amps   &kp UNDER         &kp EQUAL      &kp FSLH          &kp LS(N2)
        &none           &none  &none              &none
      >;
    };
  };
};
